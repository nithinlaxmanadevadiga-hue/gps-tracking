# GPS-Denied Real-Time Localization System - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.

PROJECT_NAME="GPS-Denied Real-Time Localization System"

# Security (Generate a strong 32+ character secret for production JWT tokens)
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite (default for standalone/quick deploy):
DATABASE_URL="sqlite+aiosqlite:///./gps_tracking.db"
# Managed PostgreSQL (recommended for production):
# DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>"

# Device Authentication Token (Used by tracking units to ingest telemetry)
DEFAULT_DEVICE_TOKEN="replace_with_a_secure_device_token_secret"

# CORS Configuration (Comma-separated list of allowed origins, or * for all)
CORS_ORIGINS="*"

# MQTT Telemetry Bridge (Optional, set MQTT_ENABLE=true if MQTT broker is present)
MQTT_ENABLE="false"
MQTT_BROKER="localhost"
MQTT_PORT=1883
MQTT_TOPIC="telemetry/#"

# Host & Port
HOST="0.0.0.0"
PORT=8000

# Frontend Environment Variables (Set when building/hosting frontend separately)
# VITE_API_BASE_URL="https://your-api-domain.com/api"
# VITE_WS_BASE_URL="wss://your-api-domain.com"
